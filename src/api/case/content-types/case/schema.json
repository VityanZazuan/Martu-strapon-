{
  "kind": "collectionType",
  "collectionName": "cases",
  "info": {
    "singularName": "case",
    "pluralName": "cases",
    "displayName": "Case"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "names": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "string",
      "default": "2025",
      "required": true,
      "regex": "^[12][0-9]{3}$"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    }
  }
}
